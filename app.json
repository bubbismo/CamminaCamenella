{
  "expo": {
    "name": "CamminaCamenella",
    "slug": "CamminaCamenella",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.camminacamenella.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E5202A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "it.camminacamenella.app",
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icon-192.png"
    },
    "backgroundColor": "#E5202A",
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CamminaCamenella usa la posizione, anche con lo schermo spento, per registrare il tuo percorso.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "baseUrl": "/CamminaCamenella"
    }
  }
}